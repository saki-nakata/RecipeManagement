# このファイルをコピーして terraform.tfvars を作成し、値を記入してください
# cp terraform.tfvars.example terraform.tfvars
#
# ⚠️ terraform.tfvars は .gitignore に追加済みです（機密情報を含む可能性があるため）

# AWS リージョン（東京）
aws_region = "ap-northeast-1"

# プロジェクト名（AWS リソースの名前に使われる）
project_name = "recipe-management"

# GitHub リポジトリの URL（EC2 が git clone する）
# 例: "https://github.com/saki-nakata/RecipeManagement.git"
github_repo_url = "https://github.com/YOUR_USERNAME/RecipeManagement.git"

# SSH 公開鍵のパス（EC2 へのログインに使用）
ssh_public_key_path = "~/.ssh/id_ed25519.pub"
